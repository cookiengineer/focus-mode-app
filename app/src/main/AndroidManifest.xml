<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Read the contact list and the phone numbers to build the allowlist. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Reflect the allowlist into the "starred/favorite" contacts so Do Not
         Disturb priority mode lets exactly those people through. -->
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />

    <!-- Do Not Disturb policy control (granted through a settings screen). -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- The persistent "Focus Mode is active" foreground notification. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:name=".FocusModeApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FocusMode">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".focus.FocusModeService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps Focus Mode active and verifies the interruption policy while enabled." />
        </service>

        <!-- Screens incoming calls against the allowlist. Requires the
             ROLE_CALL_SCREENING role (granted through a system dialog). -->
        <service
            android:name=".telecom.CallScreeningServiceImpl"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>
    </application>

</manifest>
